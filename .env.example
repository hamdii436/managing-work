# Application Configuration
APP_NAME=Google Maps Business Automation
APP_VERSION=1.0.0
APP_DEBUG=False
APP_LOG_LEVEL=INFO
APP_THEME=dark

# Database
DATABASE_PATH=./data/database.db
DATABASE_BACKUP_ENABLED=True
DATABASE_BACKUP_PATH=./data/backups

# Export Settings
EXPORT_PATH=./exports
EXPORT_CHUNK_SIZE=1000

# Scraper Settings
SCRAPER_TIMEOUT=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY=2
SCRAPER_RATE_LIMIT_DELAY=2
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_HEADLESS=True
SCRAPER_BROWSER=chromium

# Search Settings
SEARCH_MAX_RESULTS_PER_CATEGORY=500
SEARCH_MAX_CONCURRENT_THREADS=3
SEARCH_TIMEOUT=120
SEARCH_CACHE_ENABLED=True
SEARCH_CACHE_TTL=3600

# Plugin System
PLUGIN_ENABLED=True
PLUGIN_PATH=./plugins
PLUGIN_AUTO_LOAD=True

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# UI Settings
UI_WINDOW_WIDTH=1200
UI_WINDOW_HEIGHT=800
UI_AUTO_SAVE_WINDOW_STATE=True
UI_ANIMATION_ENABLED=True

# API Rate Limiting
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60

# Auto-update
AUTO_UPDATE_ENABLED=False
AUTO_UPDATE_CHECK_INTERVAL=86400
UPDATE_URL=https://api.github.com/repos/username/repo/releases/latest

# Performance
CACHE_ENABLED=True
CACHE_SIZE=100
RESULTS_PAGINATION_SIZE=50

# Feature Flags
FEATURE_ADVANCED_FILTERS=True
FEATURE_BATCH_SEARCH=True
FEATURE_SEARCH_HISTORY=True
FEATURE_DUPLICATE_DETECTION=True
FEATURE_SCHEDULED_SEARCHES=False

# AI music and YouTube automation prototype
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
MUSIC_GENRE=
YOUTUBE_REGION_CODE=US
YOUTUBE_API_KEY=
DAILY_CONTENT_LIMIT=8

# Music generation: configure an external provider implementing the documented HTTP job contract
MUSIC_API_URL=
MUSIC_API_TOKEN=
MUSIC_POLL_INTERVAL_SECONDS=10
MUSIC_JOB_TIMEOUT_SECONDS=1800

# User OAuth credentials for YouTube upload/playlist/Analytics access; never commit secrets
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_ID=
YOUTUBE_PRIVACY_STATUS=private
PUBLISH_ENABLED=false

# Local media and scheduler options
CONTENT_IMAGE_PATH=
THUMBNAIL_IMAGE_PATH=
AUTOMATION_OUTPUT_DIR=./data/ai_music
AUTOMATION_DATABASE_PATH=./data/ai_music/automation.sqlite3
FFMPEG_PATH=ffmpeg
TITLE_TEST_HOURS=24
TITLE_TEST_MIN_VIEWS=100
API_TIMEOUT_SECONDS=60
SCHEDULER_ENABLED=false
